{
  "name": "blindfake",
  "version": "0.2.0-phantom",
  "description": "BlindFake: Phantom \u2014 Professional 3D/2D Web Game Engine with Cinematic Editor, Animation Tools, and Multiplayer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "tsc && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/src/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "metrics": "node scripts/metrics.mjs",
    "check-encoding": "node scripts/check-encoding.mjs",
    "knip": "knip",
    "check": "npm run typecheck && npm run typecheck:test && npm run typecheck:server && npm run lint && npm run check-encoding && npm run check-readme-claims && npm run test:coverage && npm run build && npm run build:server",
    "check-readme-claims": "node scripts/check-readme-claims.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "express": "^4.21.0",
    "fengari-web": "^0.1.4",
    "three": "^0.170.0",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.1.0",
    "eslint": "^9.20.0",
    "eslint-plugin-no-unsanitized": "^4.1.2",
    "jsdom": "^28.1.0",
    "knip": "^5.40.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.30.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.19"
  }
}
